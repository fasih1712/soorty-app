<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Static Files Direct Bypass -->
        <rule name="StaticFiles" stopProcessing="true">
          <match url="^static/(.*)$" />
          <action type="Rewrite" url="staticfiles/{R:1}" />
        </rule>
        
        <!-- Media Files Direct Bypass -->
        <rule name="MediaFiles" stopProcessing="true">
          <match url="^media/(.*)$" />
          <action type="Rewrite" url="media/{R:1}" />
        </rule>

        <!-- Proxy All Other Requests to Waitress -->
        <rule name="ReverseProxyToWaitress" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
