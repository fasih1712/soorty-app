# Copy to .env and fill in. NEVER commit the real .env.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated, no spaces. Keep 127.0.0.1 (container healthcheck) + server IP and/or domain.
ALLOWED_HOSTS=127.0.0.1,localhost,1.2.3.4,soorty.example.com
# Full origins incl. scheme.
CSRF_TRUSTED_ORIGINS=http://1.2.3.4:8090,https://soorty.example.com

# --- Oracle (used by Django ORM: core/settings.py) ---
# Django uses ONLY DB_SERVICE as an EZConnect string: host:port/service_name
DB_SERVICE=db-host:1521/SERVICENAME
DB_USER=
DB_PASSWORD=

# --- Oracle (used by raw queries: apps/wastage/oracle_data.py, test scripts) ---
DB_HOST=db-host
DB_PORT=1521
DB_SERVICE_NAME=SERVICENAME

# Leave EMPTY on Linux/Docker (thin mode).
# Set only on Windows / if DB is too old for thin mode (e.g. D:\client19c\product\client_1\bin).
ORACLE_CLIENT_LIB=

# --- Features ---
FINANCE_HOOKS_ENABLED=N

# Not used by the code right now
REDIS_URL=
