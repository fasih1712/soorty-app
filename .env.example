# Copy to .env and fill in. NEVER commit the real .env.
# On the server this file sits at /opt/soorty/.env (next to docker-compose.prod.yml).

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated, no spaces. Keep 127.0.0.1 (container healthcheck) + server IP and/or domain.
ALLOWED_HOSTS=127.0.0.1,localhost,13.233.73.99
# Full origins incl. scheme.
CSRF_TRUSTED_ORIGINS=http://13.233.73.99:8090

# --- PostgreSQL (container "soorty-db" on the same EC2) ---
# The DB container creates this database + user on its first start.
DB_NAME=soorty
DB_USER=soorty
DB_PASSWORD=change-me-strong-password
# docker-compose sets DB_HOST=soorty-db for the app; for a local run use localhost.
DB_HOST=localhost
DB_PORT=5432
DB_TIMEZONE=Asia/Karachi

# Host port the app is published on
APP_PORT=8090

# --- Features ---
FINANCE_HOOKS_ENABLED=N
